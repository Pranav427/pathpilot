# Copy these values into Streamlit Community Cloud's Secrets editor.
# Never commit a real secrets.toml file.

LLM_PROVIDER = "anthropic"
ANTHROPIC_API_KEY = "replace_with_your_anthropic_api_key"
ANTHROPIC_MODEL = "claude-sonnet-4-5"

APPLYSMART_ALPHA_MODE = "true"
APP_PASSWORD = "replace_with_a_strong_shared_password"
MAX_AI_ACTIONS_PER_SESSION = "20"

CANDIDATE_NAME = "Your Name"
CANDIDATE_EMAIL = "your.email@example.com"
CANDIDATE_PHONE = "+91 00000 00000"
CANDIDATE_LINKEDIN = "https://linkedin.com/in/your-profile"
CANDIDATE_GITHUB = "https://github.com/your-username"
CANDIDATE_PORTFOLIO = "https://your-portfolio.example.com"
CANDIDATE_LOCATION = "Your City, State, Country"
