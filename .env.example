# Copy this file to .env and replace the placeholders with your own values.
# AI provider. Supported values: anthropic, gemini
LLM_PROVIDER=anthropic

# Claude is the default provider.
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional Gemini configuration. Set LLM_PROVIDER=gemini to use it.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Candidate contact details used in generated documents.
CANDIDATE_NAME=Your Name
CANDIDATE_EMAIL=your.email@example.com
CANDIDATE_PHONE=+91 00000 00000
CANDIDATE_LINKEDIN=https://linkedin.com/in/your-profile
CANDIDATE_GITHUB=https://github.com/your-username
CANDIDATE_PORTFOLIO=https://your-portfolio.example.com
CANDIDATE_LOCATION=Your City, State, Country

# Live discovery uses a small vetted public-source catalog by default.
# Legacy APPLYSMART_* variable names are retained for compatibility during the
# PathPilot rebrand.
APPLYSMART_USE_CURATED_LIVE_SOURCES=true

# No-key public feeds that add remote/early-career web coverage.
APPLYSMART_ENABLE_EARLY_CAREER_SOURCES=true

# Optional custom/override Greenhouse job-board APIs.
# Format: board_token|Company Name,board_token|Company Name
# Leave blank to use the curated defaults.
GREENHOUSE_BOARDS=

# Optional custom/override Lever Postings APIs.
# Format: site|Company Name|global (region may be global or eu)
# Leave blank to use the curated defaults.
LEVER_SITES=

# Optional custom/override Ashby public job-board APIs.
# Format: job_board_name|Company Name,job_board_name|Company Name
# Leave blank to use the curated defaults.
ASHBY_BOARDS=

# Local normalized inventory window. The freshness slider still filters visible
# results; this only controls how much recently-seen source inventory can be
# ranked before filtering.
APPLYSMART_JOB_INVENTORY_WINDOW_DAYS=90

# Optional broad job-market search. Register at developer.adzuna.com.
# Use a country supported by your Adzuna account (India commonly uses `in`).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Optional second broad job-market search. Register at jooble.org/api/about.
JOOBLE_API_KEY=
JOOBLE_COUNTRY=in

# Optional Google Jobs search through SerpAPI. This can surface listings from
# LinkedIn, Naukri, Indeed, and company career pages when Google exposes them.
SERPAPI_API_KEY=

# Developer/offline workflow testing only. Keep false for normal users.
APPLYSMART_ENABLE_SAMPLE_JOBS=false
